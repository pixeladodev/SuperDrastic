From d53c60317ea88336804c97dd3d4d1833154c6d82 Mon Sep 17 00:00:00 2001
From: Pixelado Dev <350114043+pixeladodev@users.noreply.github.com>
Date: Tue, 17 Nov 2026 02:29:21 -0500
Subject: [PATCH] LAN: a DS Download Play host takes MP replies as they come,
 no wait per command

---
 src/net/LAN.cpp | 74 +++++++++++++++++++++++++++++++++++++++++++++++--
 src/net/LAN.h   |  5 ++++
 2 files changed, 77 insertions(+), 2 deletions(-)

diff --git a/src/net/LAN.cpp b/src/net/LAN.cpp
index f62c46f..79eacea 100644
--- a/src/net/LAN.cpp
+++ b/src/net/LAN.cpp
@@ -64,6 +64,49 @@ const u32 kLocalhost = 0x0100007F;
 // MPRecvTimeout wait) is no longer waited for, until it sends us a reply or an auth/association request again
 const int kMPMaxMisses = 20;
 
+// BananaDS: DS Download Play. Its host sends ~10 MP commands a frame with the game's data, and the wait for each
+// reply is a round trip over Wi-Fi (3-5 ms between two handhelds through a router): 10 of them a frame took the
+// host to ~20-30 fps and its sound with it. While we send DS Download Play beacons (beacon type 0Bh, multiboot, in
+// Nintendo's DDh element; GBATEK "DS Wifi Nintendo Beacons"), RecvReplies does not wait: each MP command gets the
+// replies already in, up to kMultibootReplyWindowUS old (so a command usually gets the reply to one sent a few
+// before it). DS Download Play is built for lost replies (a child that did not answer is sent the block again),
+// so this costs some of the transfer's speed, not the transfer. A child that stops replying is not counted out
+// meanwhile. Back to the usual wait 2 s after the last such beacon (the game itself, after the download, sends its
+// own beacons). BANANADS_LAN_DLPLAY_PIPELINE=0 turns it off.
+const u32 kMultibootBeaconHoldMS = 2000;
+const u64 kMultibootReplyWindowUS = 100000;
+
+static bool MultibootPipelineEnabled()
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        const char* e = getenv("BANANADS_LAN_DLPLAY_PIPELINE");
+        v = (e && e[0] == '0') ? 0 : 1;
+    }
+    return v == 1;
+}
+
+// a beacon (802.11 frame after the 12-byte TX header) that announces DS Download Play: Nintendo's DDh element,
+// OUI 00:09:BF:00, beacon type 0Bh at its offset 13h
+static bool IsMultibootBeacon(const u8* packet, int len)
+{
+    if (!packet || len < 12 + 24 + 12) return false;
+    const u16 fc = packet[12] | (packet[13] << 8);
+    if ((fc & 0x00FC) != 0x0080) return false;
+    int i = 12 + 24 + 12;
+    while (i + 2 <= len)
+    {
+        const int tag = packet[i], tlen = packet[i + 1];
+        if (i + 2 + tlen > len) break;
+        if (tag == 0xDD && tlen >= 0x14 && packet[i + 2] == 0x00 && packet[i + 3] == 0x09 && packet[i + 4] == 0xBF &&
+            packet[i + 5] == 0x00)
+            return packet[i + 2 + 0x13] == 0x0B;
+        i += 2 + tlen;
+    }
+    return false;
+}
+
 // BananaDS diagnostics: Debug level (BananaDS log.level 0), "[diag] LAN" prefix, rate-limited
 namespace landiag
 {
@@ -1461,6 +1504,8 @@ int LAN::SendPacketGeneric(u32 type, u8* packet, int len, u64 timestamp)
             memcpy(MyMAC, &packet[12 + 10], 6);
             MyMACKnown = true;
         }
+        if (t == 0 && IsMultibootBeacon(packet, len))
+            MultibootBeaconAt = (u32)Platform::GetMSCount();
     }
 
     if (!Repeating) RepeatCheck(packet, type, len, timestamp);
@@ -1594,10 +1639,31 @@ int LAN::RecvHostPacket(int inst, u8* packet, u64* timestamp)
     return ret;
 }
 
+bool LAN::MultibootPipeline()
+{
+    bool on = MultibootPipelineEnabled() && MultibootBeaconAt &&
+              (u32)Platform::GetMSCount() - MultibootBeaconAt < kMultibootBeaconHoldMS;
+    if (on != MultibootOn)
+    {
+        MultibootOn = on;
+        Platform::Log(Platform::LogLevel::Info, on
+            ? "LAN: DS Download Play host: MP replies taken as they come, no wait per command\n"
+            : "LAN: DS Download Play host: done, the usual wait for MP replies again\n");
+        if (!on) memset(MPMissCount, 0, sizeof(MPMissCount));
+    }
+    return on;
+}
+
 u16 LAN::RecvReplies(int inst, u8* packets, u64 timestamp, u16 aidmask)
 {
     if (!Host) return 0;
 
+    const bool pipe = MultibootPipeline();
+    const int savedtimeout = MPRecvTimeout;
+    if (pipe) MPRecvTimeout = 0;
+    const u64 oldest = pipe ? (timestamp > kMultibootReplyWindowUS ? timestamp - kMultibootReplyWindowUS : 0)
+                            : timestamp - 32;
+
     u16 ret = 0;
     u16 myinstmask = 1 << MyPlayer.ID;
     u16 alivemask = 0;                 // players a reply came from (even a late one)
@@ -1611,6 +1677,7 @@ u16 LAN::RecvReplies(int inst, u8* packets, u64 timestamp, u16 aidmask)
     };
     auto finish = [&](bool timedout) -> u16
     {
+        MPRecvTimeout = savedtimeout;
         landiag::NoteWait(waitstart);
         if (timedout && landiag::EnvTimeoutMS()) landiag::NReplyTimeout++;
         if (!timedout && landiag::CmdSentAt && landiag::EnvTimeoutMS())
@@ -1638,7 +1705,7 @@ u16 LAN::RecvReplies(int inst, u8* packets, u64 timestamp, u16 aidmask)
         {
             if (i == MyPlayer.ID) continue;
             if (alivemask & (1 << i)) { MPMissCount[i] = 0; continue; }
-            if (!timedout || !(waitmask() & (1 << i))) continue;
+            if (!timedout || pipe || !(waitmask() & (1 << i))) continue;
             if (MPMissCount[i] < 255) MPMissCount[i]++;
             if (MPMissCount[i] >= kMPMaxMisses)
                 MPSetActive(i, false, "no reply to 20 MP commands in a row");
@@ -1647,7 +1714,10 @@ u16 LAN::RecvReplies(int inst, u8* packets, u64 timestamp, u16 aidmask)
     };
 
     if ((myinstmask & waitmask()) == waitmask())
+    {
+        MPRecvTimeout = savedtimeout;
         return 0;
+    }
 
     for (;;)
     {
@@ -1679,7 +1749,7 @@ u16 LAN::RecvReplies(int inst, u8* packets, u64 timestamp, u16 aidmask)
         else
         {
             if (header->SenderID < 16) alivemask |= (1 << header->SenderID);
-            if (header->Timestamp < (timestamp - 32))
+            if (header->Timestamp < oldest)
                 good = false;
         }
 
diff --git a/src/net/LAN.h b/src/net/LAN.h
index 7a8100f..c7bf1a5 100644
--- a/src/net/LAN.h
+++ b/src/net/LAN.h
@@ -173,6 +173,11 @@ private:
     u8 MPMissCount[16];  // MP commands in a row a MP-active player didn't reply to (RecvReplies timed out)
     u8 MyMAC[6];         // this console's DS MAC, from the beacons/MP commands it sends (host side)
     bool MyMACKnown;
+    // BananaDS: DS Download Play host. While we send DS Download Play (multiboot) beacons, RecvReplies takes the
+    // replies that have come in and does not wait for the rest (see LAN.cpp, MultibootPipeline)
+    u32 MultibootBeaconAt = 0;
+    bool MultibootOn = false;
+    bool MultibootPipeline();
     void MPSetActive(int id, bool on, const char* why);
     // H: our wifi is on: tell a peer that just joined (it missed the Cmd_PlayerConnect we broadcast as it powered on)
     void SendWifiStateTo(ENetPeer* peer, int id, const char* why);
